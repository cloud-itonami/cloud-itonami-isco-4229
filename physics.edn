;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": an information-desk robot performs visitor
;; check-in, directory lookup and physical document handoff (ISCO 4229). Its
;; physical work is handing a document folder across the desk, and escorting
;; a client to the right service point.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-4229"
 :cases
 [{:id :document-folder-handoff
   :kind :manipulator
   :procedure "desktop arm takes a client's document folder from the desk tray and holds it out to the client; a faster handoff shortens the queue"
   :params {:l1-m 0.30 :l2-m 0.25 :m1-kg 1.5 :m2-kg 1.0 :payload-kg 0.5
            :from [0.15 0.40] :to [0.50 0.10] :steps 300}
   :sweep {:param :duration-s :values [0.25 0.4 0.6 1.0 2.0]}
   :quantity :peak-tau1-nm
   :limit {:max 15.0 :basis "estimate: continuous shoulder torque of a desktop arm (~1-3 kg class)"}
   :boundary {:lo 0.05 :hi 3.0}}
  {:id :client-escort-to-service-point
   :kind :transport
   :procedure "robot escorts a client from the information desk to the service point that handles their request"
   :params {:mass-kg 45.0 :payload-kg 0.0 :v-max-mps 0.8 :a-max-mps2 0.4
            :brake-decel-mps2 0.6 :drive-force-n 90.0 :crr 0.02
            :cog-height-m 0.60 :support-half-length-m 0.25}
   :sweep {:param :distance-m :values [15.0 30.0 50.0 80.0 120.0]}
   :quantity :cycle-time-s
   :limit {:max 90.0 :basis "estimate: the desk may be unattended for at most about 3 minutes per escort round trip"}
   :boundary {:lo 2.0 :hi 400.0}}]}
